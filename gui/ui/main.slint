import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox, Palette } from "std-widgets.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active: false;
    callback clicked;

    height: 38px;
    border-radius: 8px;
    background: active ? #f5730022 : (touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent);
    animate background { duration: 120ms; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            text: root.icon;
            font-size: 14px;
            vertical-alignment: center;
            color: active ? #f57300 : Palette.foreground.with-alpha(0.75);
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: active ? 700 : 600;
            vertical-alignment: center;
            color: active ? #f57300 : Palette.foreground.with-alpha(0.85);
        }
    }
}

component Sidebar inherits Rectangle {
    in property <bool> settings-active: false;
    callback show-about();
    callback show-devices();
    callback show-settings();

    width: 190px;
    background: Palette.background.darker(0.05);
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.08);

    VerticalLayout {
        padding: 16px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            Image { source: @image-url("../assets/app-icon.svg"); width: 26px; height: 26px; }
            Text { text: "CtrlGear"; font-size: 15px; font-weight: 800; vertical-alignment: center; }
        }

        Rectangle { height: 16px; }

        Text {
            text: "LIBRARY";
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            color: Palette.foreground.with-alpha(0.4);
        }
        NavItem { label: "Devices"; icon: "▤"; active: !root.settings-active; clicked => { root.show-devices(); } }
        NavItem { label: "Settings"; icon: "⚙"; active: root.settings-active; clicked => { root.show-settings(); } }

        Rectangle { vertical-stretch: 1; }

        NavItem { label: "About"; icon: "ⓘ"; clicked => { root.show-about(); } }
    }
}

export struct DeviceCardData {
    name: string,
    initial: string,
    product-id-hex: string,
    supported: bool,
    has-battery: bool,
    battery-percent: int,
    charging: bool,
    status: string,
    accent-start: color,
    accent-end: color,
    connection-label: string,
}

component BatteryBadge inherits Rectangle {
    in property <int> percent;
    in property <bool> charging;
    in property <bool> on-dark: false;
    property <color> tint: percent < 20 ? #e05050 : percent < 40 ? #d19a66 : #4caf50;

    border-radius: 11px;
    background: on-dark ? #ffffff33 : tint.with-alpha(0.15);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        alignment: center;
        Text {
            text: (charging ? "Charging ⚡ " : "") + percent + "%";
            color: on-dark ? white : tint;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component DeviceRow inherits Rectangle {
    in property <DeviceCardData> data;
    callback clicked;

    height: 84px;
    border-radius: 12px;
    clip: true;
    background: @linear-gradient(120deg, data.accent-start, data.accent-end);
    border-width: touch.has-hover ? 2px : 0px;
    border-color: #ffffff55;
    animate border-width { duration: 120ms; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: data.supported ? pointer : default;
        clicked => { if data.supported { root.clicked(); } }
    }

    HorizontalLayout {
        padding: 16px;
        spacing: 14px;

        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 26px;
            background: #ffffff26;
            Text {
                text: data.initial;
                color: white;
                font-weight: 800;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 5px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: data.name; color: white; font-size: 16px; font-weight: 800; overflow: elide; horizontal-stretch: 1; }
                if data.connection-label != "": Rectangle {
                    border-radius: 6px;
                    background: #ffffff26;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Text { text: data.connection-label; color: white; font-size: 9px; font-weight: 700; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    border-radius: 8px;
                    background: #ffffff26;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Text {
                            text: data.supported ? "Supported" : "Not yet supported";
                            color: white;
                            font-size: 10px;
                            font-weight: 600;
                        }
                    }
                }
                if !data.has-battery && data.status != "": Text {
                    text: data.status;
                    color: #ffe0e0;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 5px;
            if data.has-battery: BatteryBadge { percent: data.battery-percent; charging: data.charging; on-dark: true; }
            Text {
                text: touch.has-hover ? (data.supported ? "Configure ›" : "Not available") : "ID " + data.product-id-hex;
                color: #ffffffcc;
                font-size: 11px;
                horizontal-alignment: right;
            }
        }
    }
}

component DeviceListPage inherits Rectangle {
    in property <[DeviceCardData]> devices;
    in property <bool> loading;
    callback refresh();
    callback select-device(int);

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 8px;
            Text { text: "Devices"; font-size: 22px; font-weight: 800; vertical-alignment: center; horizontal-stretch: 1; }
            Button { text: loading ? "Refreshing…" : "Refresh"; enabled: !loading; clicked => { root.refresh(); } }
        }

        Rectangle { height: 1px; background: Palette.foreground.with-alpha(0.08); }

        if devices.length == 0 && !loading: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 6px;
            Text { text: "No SteelSeries devices found."; font-size: 14px; horizontal-alignment: center; color: Palette.foreground.with-alpha(0.6); }
            Text { text: "Connect a device and press Refresh."; font-size: 12px; horizontal-alignment: center; color: Palette.foreground.with-alpha(0.45); }
        }

        if devices.length > 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;
            Text {
                text: "CONNECTED";
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                color: Palette.foreground.with-alpha(0.4);
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    for card[i] in devices: DeviceRow {
                        data: card;
                        clicked => { root.select-device(i); }
                    }
                }
            }
        }
    }
}

component DeviceDetailPage inherits Rectangle {
    in property <string> name;
    in property <string> product-id-hex;
    in property <bool> supported;
    in property <bool> supports-dpi;
    in property <bool> supports-polling-rate;
    in property <bool> supports-button-mapping;
    in property <bool> has-battery;
    in property <int> battery-percent;
    in property <bool> charging;
    in property <bool> has-chatmix;
    in property <int> chatmix-game-percent;
    in property <int> chatmix-chat-percent;
    in property <string> status;
    in property <color> status-color: Palette.foreground;
    in-out property <string> dpi-input;
    in property <string> dpi-help: "";
    in-out property <int> polling-rate-index: 3;
    in-out property <int> button-mapping-index-0: 4;
    in-out property <int> button-mapping-index-1: 4;
    in-out property <int> button-mapping-index-2: 4;
    in-out property <int> button-mapping-index-3: 4;
    in-out property <int> button-mapping-index-4: 4;
    in-out property <int> button-mapping-index-5: 4;
    callback back();
    callback apply-dpi(string);
    callback apply-polling-rate(int);
    callback apply-button-mapping([int]);

    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            padding: 18px;
            spacing: 16px;

            Button { text: "← Devices"; horizontal-stretch: 0; clicked => { root.back(); } }

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: root.name; font-size: 20px; font-weight: 800; }
                    Text { text: "ID " + product-id-hex; font-size: 11px; color: Palette.foreground.with-alpha(0.6); }
                }
                if has-battery: BatteryBadge { percent: battery-percent; charging: charging; }
            }

            if !supported: Rectangle {
                border-radius: 10px;
                background: Palette.foreground.with-alpha(0.06);
                VerticalLayout {
                    padding: 16px;
                    Text {
                        text: "This device isn't supported yet.";
                        wrap: word-wrap;
                        color: Palette.foreground.with-alpha(0.7);
                    }
                }
            }

            if has-chatmix: Rectangle {
                border-radius: 10px;
                background: Palette.foreground.with-alpha(0.04);
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "ChatMix"; font-weight: 700; font-size: 13px; }
                    Text {
                        text: "Game " + chatmix-game-percent + "%  ·  Chat " + chatmix-chat-percent + "%";
                        font-size: 12px;
                        color: Palette.foreground.with-alpha(0.75);
                    }
                }
            }

            if supported && supports-dpi: Rectangle {
                border-radius: 10px;
                background: Palette.foreground.with-alpha(0.04);
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "DPI presets"; font-weight: 700; font-size: 13px; }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit { text <=> root.dpi-input; placeholder-text: "400,800,1600"; horizontal-stretch: 1; }
                        Button { text: "Apply"; horizontal-stretch: 0; clicked => { root.apply-dpi(root.dpi-input); } }
                    }
                    if dpi-help != "": Text { text: dpi-help; font-size: 11px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.55); }
                    if status != "": Text { text: status; font-size: 11px; wrap: word-wrap; color: status-color; }
                }
            }

            if supported && supports-polling-rate: Rectangle {
                border-radius: 10px;
                background: Palette.foreground.with-alpha(0.04);
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "Polling rate"; font-weight: 700; font-size: 13px; }
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            model: ["125 Hz", "250 Hz", "500 Hz", "1000 Hz"];
                            current-index <=> root.polling-rate-index;
                            horizontal-stretch: 1;
                        }
                        Button { text: "Apply"; horizontal-stretch: 0; clicked => { root.apply-polling-rate(root.polling-rate-index); } }
                    }
                }
            }

            if supported && supports-button-mapping: Rectangle {
                border-radius: 10px;
                background: Palette.foreground.with-alpha(0.04);
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "Button mapping"; font-weight: 700; font-size: 13px; }
                    Text { text: "Each row is one physical button on the mouse; pick what it should do."; font-size: 11px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.55); }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Button 1 (Left-Click)"; vertical-alignment: center; width: 140px; }
                        ComboBox {
                            model: ["Disabled", "DPI Switch", "Scroll Up", "Scroll Down", "Default", "Button 1", "Button 2", "Button 3", "Button 4", "Button 5", "Button 6"];
                            current-index <=> root.button-mapping-index-0;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Button 2 (Right-Click)"; vertical-alignment: center; width: 140px; }
                        ComboBox {
                            model: ["Disabled", "DPI Switch", "Scroll Up", "Scroll Down", "Default", "Button 1", "Button 2", "Button 3", "Button 4", "Button 5", "Button 6"];
                            current-index <=> root.button-mapping-index-1;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Button 3 (Middle-Click)"; vertical-alignment: center; width: 140px; }
                        ComboBox {
                            model: ["Disabled", "DPI Switch", "Scroll Up", "Scroll Down", "Default", "Button 1", "Button 2", "Button 3", "Button 4", "Button 5", "Button 6"];
                            current-index <=> root.button-mapping-index-2;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Button 4 (Forward)"; vertical-alignment: center; width: 140px; }
                        ComboBox {
                            model: ["Disabled", "DPI Switch", "Scroll Up", "Scroll Down", "Default", "Button 1", "Button 2", "Button 3", "Button 4", "Button 5", "Button 6"];
                            current-index <=> root.button-mapping-index-3;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Button 5 (Back)"; vertical-alignment: center; width: 140px; }
                        ComboBox {
                            model: ["Disabled", "DPI Switch", "Scroll Up", "Scroll Down", "Default", "Button 1", "Button 2", "Button 3", "Button 4", "Button 5", "Button 6"];
                            current-index <=> root.button-mapping-index-4;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Button 6 (DPI Button)"; vertical-alignment: center; width: 140px; }
                        ComboBox {
                            model: ["Disabled", "DPI Switch", "Scroll Up", "Scroll Down", "Default", "Button 1", "Button 2", "Button 3", "Button 4", "Button 5", "Button 6"];
                            current-index <=> root.button-mapping-index-5;
                            horizontal-stretch: 1;
                        }
                    }
                    Button {
                        text: "Apply";
                        clicked => {
                            root.apply-button-mapping([
                                root.button-mapping-index-0,
                                root.button-mapping-index-1,
                                root.button-mapping-index-2,
                                root.button-mapping-index-3,
                                root.button-mapping-index-4,
                                root.button-mapping-index-5,
                            ]);
                        }
                    }
                    if status != "": Text { text: status; font-size: 11px; wrap: word-wrap; color: status-color; }
                }
            }

            if supported && !supports-dpi && !supports-polling-rate && !supports-button-mapping: Rectangle {
                border-radius: 10px;
                background: Palette.foreground.with-alpha(0.04);
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    Text { text: "No adjustable settings implemented yet for this device."; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                    if status != "": Text { text: status; font-size: 11px; wrap: word-wrap; color: status-color; }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}

component SettingsPage inherits Rectangle {
    in-out property <int> poll-interval-minutes;
    in-out property <bool> tray-icon-monochrome;
    in-out property <bool> notification-persistent;
    in-out property <int> notification-sound-index;
    callback save-poll-interval(int);
    callback set-tray-icon-monochrome(bool);
    callback set-notification-persistent(bool);
    callback set-notification-sound(int);
    callback preview-sound(int);

    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text { text: "Settings"; font-size: 22px; font-weight: 800; }

            Rectangle { height: 1px; background: Palette.foreground.with-alpha(0.08); }

            Rectangle {
                border-radius: 10px;
                background: Palette.foreground.with-alpha(0.04);
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "Battery check interval"; font-weight: 700; font-size: 13px; }
                    Text {
                        text: "How often the system tray re-checks connected devices' battery levels.";
                        font-size: 11px;
                        wrap: word-wrap;
                        color: Palette.foreground.with-alpha(0.6);
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        SpinBox {
                            minimum: 1;
                            maximum: 120;
                            value <=> root.poll-interval-minutes;
                            horizontal-stretch: 1;
                        }
                        Text { text: "minutes"; vertical-alignment: center; color: Palette.foreground.with-alpha(0.6); }
                        Button { text: "Apply"; horizontal-stretch: 0; clicked => { root.save-poll-interval(root.poll-interval-minutes); } }
                    }
                }
            }

            Rectangle {
                border-radius: 10px;
                background: Palette.foreground.with-alpha(0.04);
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "Tray icon"; font-weight: 700; font-size: 13px; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Colored"; clicked => { root.set-tray-icon-monochrome(false); } }
                        Button { text: "Monochrome"; clicked => { root.set-tray-icon-monochrome(true); } }
                    }
                }
            }

            Rectangle {
                border-radius: 10px;
                background: Palette.foreground.with-alpha(0.04);
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "Low-battery notification"; font-weight: 700; font-size: 13px; }
                    HorizontalLayout {
                        spacing: 8px;
                        CheckBox {
                            text: "Keep until manually dismissed";
                            checked: root.notification-persistent;
                            toggled => { root.set-notification-persistent(self.checked); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            model: ["Default sound", "Silent", "Dialog warning", "Message"];
                            current-index <=> root.notification-sound-index;
                            selected(value) => { root.set-notification-sound(root.notification-sound-index); }
                            horizontal-stretch: 1;
                        }
                        Button { text: "▶ Preview"; horizontal-stretch: 0; clicked => { root.preview-sound(root.notification-sound-index); } }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    in property <bool> monochrome: false;
    icon: root.monochrome
        ? (Palette.color-scheme == ColorScheme.dark
            ? @image-url("../assets/app-icon-mono-light.svg")
            : @image-url("../assets/app-icon-mono-dark.svg"))
        : @image-url("../assets/app-icon.svg");
    tooltip: "CtrlGear";
    in property <[string]> device-labels: [];
    callback show-window();
    callback quit();

    clicked => { root.show-window(); }

    Menu {
        for label in device-labels: MenuItem { title: label; enabled: false; }
        if device-labels.length > 0: MenuSeparator {}
        MenuItem { title: "Show window"; activated => { root.show-window(); } }
        MenuItem { title: "Quit"; activated => { root.quit(); } }
    }
}

export component MainWindow inherits Window {
    title: "CtrlGear";
    icon: @image-url("../assets/app-icon.svg");
    min-width: 560px;
    min-height: 380px;
    preferred-width: 760px;
    preferred-height: 540px;
    background: Palette.background;

    in-out property <[DeviceCardData]> devices: [];
    in property <bool> loading: false;
    in property <bool> showing-detail: false;
    in-out property <bool> showing-settings: false;
    in-out property <int> poll-interval-minutes: 5;
    in-out property <bool> tray-icon-monochrome: false;
    in-out property <bool> notification-persistent: false;
    in-out property <int> notification-sound-index: 0;
    in property <string> settings-status: "";
    in property <color> settings-status-color: Palette.foreground;

    in property <string> detail-name: "";
    in property <string> detail-product-id-hex: "";
    in property <bool> detail-supported: false;
    in property <bool> detail-supports-dpi: false;
    in property <bool> detail-supports-polling-rate: false;
    in property <bool> detail-supports-button-mapping: false;
    in property <bool> detail-has-battery: false;
    in property <int> detail-battery-percent: 0;
    in property <bool> detail-charging: false;
    in property <bool> detail-has-chatmix: false;
    in property <int> detail-chatmix-game-percent: 0;
    in property <int> detail-chatmix-chat-percent: 0;
    in property <string> detail-status: "";
    in property <color> detail-status-color: Palette.foreground;
    in property <string> detail-dpi-help: "";
    in-out property <string> dpi-input: "400,800,1600";
    in-out property <int> polling-rate-index: 3;
    in-out property <int> button-mapping-index-0: 4;
    in-out property <int> button-mapping-index-1: 4;
    in-out property <int> button-mapping-index-2: 4;
    in-out property <int> button-mapping-index-3: 4;
    in-out property <int> button-mapping-index-4: 4;
    in-out property <int> button-mapping-index-5: 4;

    callback refresh();
    callback select-device(int);
    callback back-to-grid();
    callback apply-dpi(string);
    callback apply-polling-rate(int);
    callback apply-button-mapping([int]);
    callback save-poll-interval(int);
    callback save-tray-icon-style(bool);
    callback save-notification-persistent(bool);
    callback save-notification-sound(int);
    callback preview-sound(int);

    HorizontalLayout {
        Sidebar {
            settings-active: root.showing-settings;
            show-about => { about-popup.show(); }
            show-devices => { root.showing-settings = false; }
            show-settings => { root.showing-settings = true; }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Palette.background;

            if root.showing-settings: SettingsPage {
                poll-interval-minutes <=> root.poll-interval-minutes;
                tray-icon-monochrome <=> root.tray-icon-monochrome;
                notification-persistent <=> root.notification-persistent;
                notification-sound-index <=> root.notification-sound-index;
                save-poll-interval(minutes) => { root.save-poll-interval(minutes); }
                set-tray-icon-monochrome(mono) => { root.save-tray-icon-style(mono); }
                set-notification-persistent(persistent) => { root.save-notification-persistent(persistent); }
                set-notification-sound(index) => { root.save-notification-sound(index); }
                preview-sound(index) => { root.preview-sound(index); }
            }

            if !root.showing-settings && !showing-detail: DeviceListPage {
                devices: root.devices;
                loading: root.loading;
                refresh => { root.refresh(); }
                select-device(i) => { root.select-device(i); }
            }

            if !root.showing-settings && showing-detail: DeviceDetailPage {
                name: root.detail-name;
                product-id-hex: root.detail-product-id-hex;
                supported: root.detail-supported;
                supports-dpi: root.detail-supports-dpi;
                supports-polling-rate: root.detail-supports-polling-rate;
                supports-button-mapping: root.detail-supports-button-mapping;
                has-battery: root.detail-has-battery;
                battery-percent: root.detail-battery-percent;
                charging: root.detail-charging;
                has-chatmix: root.detail-has-chatmix;
                chatmix-game-percent: root.detail-chatmix-game-percent;
                chatmix-chat-percent: root.detail-chatmix-chat-percent;
                status: root.detail-status;
                status-color: root.detail-status-color;
                dpi-help: root.detail-dpi-help;
                dpi-input <=> root.dpi-input;
                polling-rate-index <=> root.polling-rate-index;
                button-mapping-index-0 <=> root.button-mapping-index-0;
                button-mapping-index-1 <=> root.button-mapping-index-1;
                button-mapping-index-2 <=> root.button-mapping-index-2;
                button-mapping-index-3 <=> root.button-mapping-index-3;
                button-mapping-index-4 <=> root.button-mapping-index-4;
                button-mapping-index-5 <=> root.button-mapping-index-5;
                back => { root.back-to-grid(); }
                apply-dpi(values) => { root.apply-dpi(values); }
                apply-polling-rate(index) => { root.apply-polling-rate(index); }
                apply-button-mapping(indices) => { root.apply-button-mapping(indices); }
            }
        }
    }

    if root.settings-status != "": Rectangle {
        width: 280px;
        height: 56px;
        clip: true;
        x: root.width - self.width - 16px;
        y: root.height - self.height - 16px;
        border-radius: 8px;
        background: root.settings-status-color.with-alpha(0.15);
        border-width: 1px;
        border-color: root.settings-status-color.with-alpha(0.4);
        Text {
            x: 10px;
            y: 6px;
            width: 260px;
            text: root.settings-status;
            color: root.settings-status-color;
            font-size: 11px;
            font-weight: 500;
            wrap: word-wrap;
        }
    }

    about-popup := PopupWindow {
        width: 280px;
        height: 168px;
        x: root.width / 2 - self.width / 2;
        y: root.height / 2 - self.height / 2;

        Rectangle {
            background: Palette.background;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.foreground.with-alpha(0.15);

            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Image { source: @image-url("../assets/app-icon.svg"); width: 22px; height: 22px; }
                    Text { text: "CtrlGear"; font-size: 15px; font-weight: 800; vertical-alignment: center; }
                }
                Text {
                    text: "Unofficial utility for configuring SteelSeries peripherals.";
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Palette.foreground.with-alpha(0.7);
                }
                Text {
                    text: "Not affiliated with or endorsed by SteelSeries.";
                    font-size: 11px;
                    wrap: word-wrap;
                    color: Palette.foreground.with-alpha(0.5);
                }
            }
        }
    }
}
